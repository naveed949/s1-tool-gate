{
  "name": "s1-tool-gate",
  "version": "0.0.0",
  "private": true,
  "description": "System-1 per-tool-call authority gate in front of AdaptiveSandbox/gondolin. Not a sandbox substitute.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/authority-flip"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "authority-flip": "node --disable-warning=ExperimentalWarning --experimental-strip-types --import ./packages/authority-flip/src/register.mjs packages/authority-flip/src/cli.ts",
    "authority-flip:verify": "node --disable-warning=ExperimentalWarning --experimental-strip-types --import ./packages/authority-flip/src/register.mjs packages/authority-flip/src/cli.ts verify"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.6",
    "eslint": "^10.11.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^5.0.2"
  }
}
